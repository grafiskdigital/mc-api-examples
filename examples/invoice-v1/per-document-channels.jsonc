// POST /jobs/invoice-v1
// Example only. Fictional values — not a request you can send as-is.
// One job, one document per channel. channels on a document replaces the job channel list.
// onHold processes the job and then stops before delivery.
{
  "jobType": "example-invoice",
  "customerId": "123456789",
  "language": "no",
  "onHold": true,
  "sender": {
    "orgNumber": "123456789",
    "name": "Eksempel AS",
    "address1": "Eksempelveien 1",
    "zip": "0150",
    "city": "Oslo",
    "country": "NO",
    "www": "https://example.no"
  },
  "documents": [
    {
      "recipient": {
        "name": "Kari",
        "lastName": "Nordmann",
        "phone": "+4768051234"
      },
      "channels": ["sms"],
      "externalRef": "example-sms",
      // Stored on the document. Not included in what the recipient receives.
      "comment": "Internal note about this document",
      "documentDetails": {
        "type": "invoice",
        "issueDate": "2026-05-12",
        "currency": "NOK",
        "invoiceNumber": "2026-1001",
        "paymentInfo": {
          "paymentId": "123456789012345",
          "accountNumber": "86011117947",
          "dueDate": "2026-07-01",
          "payableAmount": 1250
        }
      },
      "files": [
        {
          "type": "base64",
          "role": "main",
          "filename": "invoice.pdf",
          "mime": "application/pdf",
          "base64": "..."
        },
        {
          "type": "base64",
          "role": "smsTemplate",
          "filename": "sms.txt",
          "mime": "text/plain",
          "base64": "..."
        }
      ]
    },
    {
      "recipient": {
        "name": "Kari",
        "lastName": "Nordmann",
        "email": "kari.nordmann@example.com"
      },
      "channels": ["email"],
      "templates": {
        "emailSubject": "Faktura 2026-1002 fra Eksempel AS"
      },
      "externalRef": "example-email",
      "documentDetails": {
        "type": "invoice",
        "issueDate": "2026-05-12",
        "currency": "NOK",
        "invoiceNumber": "2026-1002",
        // Delivery address when it differs from the recipient address.
        "delivery": {
          "address1": "Eksempelveien 1",
          "zip": "0150",
          "city": "Oslo",
          "country": "NO"
        },
        "paymentInfo": {
          "paymentId": "123456789012346",
          "accountNumber": "86011117947",
          "dueDate": "2026-07-01",
          "payableAmount": 1250
        }
      },
      "files": [
        {
          "type": "base64",
          "role": "main",
          "filename": "invoice.pdf",
          "mime": "application/pdf",
          "base64": "..."
        },
        {
          "type": "base64",
          "role": "emailTemplate",
          "filename": "email.html",
          "mime": "text/html",
          "base64": "..."
        },
        {
          "type": "base64",
          "role": "attachment",
          "filename": "attachment.pdf",
          "mime": "application/pdf",
          "base64": "..."
        }
      ]
    },
    {
      "recipient": {
        "name": "Kari",
        "lastName": "Nordmann"
      },
      "channels": ["archive"],
      "externalRef": "example-archive",
      "documentDetails": {
        "type": "invoice",
